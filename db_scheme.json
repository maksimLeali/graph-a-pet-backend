{
    "tables": {
        "base_template": {
            "columns": {
                "id": "id!",
                "created_at": "date",
                "updated_at": "date"
            }
        },
        "users": {
            "enums": {
                "UserRole": ["USER", "ADMIN"]
            },
            "columns": {
                "first_name": "string",
                "last_name": "string",
                "email": "string",
                "password": "string",
                "role": "enum(UserRole)",
                "last_login": "date",
                "last_activity": "date",
                "verified": "bool"
            },
            "search_columns": ["first_name", "last_name", "email"],
            "alias": "us",
            "other_table_ref": "user_id",
            "children": ["ownerships", "reports", "user_pets_in_custody"],
            "inherit_delete": {
                "ownerships": {
                    "cond": "all"
                },
                "reports": {
                    "cond": "all"
                }
            }
        },
        "pets": {
            "enums": {
                "Gender": ["MALE", "FEMALE", "NOT_SAID"],
                "CoatLength": ["SHORT", "MEDIUM", "LENGHT", "HAIRLESS"]
            },
            "columns": {
                "name": "string",
                "birthday": "date",
                "neutered": "bool",
                "chip_code": "string",
